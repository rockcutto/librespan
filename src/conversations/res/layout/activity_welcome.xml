<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/welcome_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/welcome_night_mist"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar_layout"
            layout="@layout/toolbar"
            android:background="@android:color/transparent"
            android:elevation="0dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:minHeight="560dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="168dp"
                    android:layout_height="112dp"
                    android:contentDescription="@string/librespan_brand_name"
                    android:importantForAccessibility="yes"
                    android:scaleType="fitCenter"
                    android:src="@drawable/librespan_flow_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/librespan_brand_name"
                    android:textColor="@color/welcome_text_primary"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/welcome_header"
                    android:textColor="@color/welcome_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxWidth="420dp"
                    android:text="@string/do_you_have_an_account"
                    android:textColor="@color/welcome_text_secondary"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/use_existing"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/welcome_action_fill"
                    android:text="@string/welcome_sign_in"
                    android:textAllCaps="false"
                    android:textColor="@color/welcome_action_text"
                    android:textSize="16sp"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register_new_account"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/create_new_account"
                    android:textAllCaps="false"
                    android:textColor="@color/welcome_text_primary"
                    android:textSize="16sp"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/welcome_outline"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
