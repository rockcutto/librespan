        android:icon="@drawable/ic_person_24dp"
        android:layout="@layout/preference_navigation_row"
        android:title="@string/neocont_settings_account"
        android:summary="@string/neocont_settings_account_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="eu.siacs.conversations.ui.ManageAccountActivity"
            android:targetPackage="@string/applicationId" />
    </PreferenceScreen>

