            android:summary="@string/neocont_chat_wallpaper_summary"
            android:title="@string/neocont_chat_wallpaper" />
        <eu.siacs.conversations.ui.appearance.MessageTextSizePreference
            android:key="message_text_size_sp"
            android:title="@string/pref_text_scale" />
