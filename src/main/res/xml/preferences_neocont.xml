        android:title="@string/neocont_settings_appearance"
        android:summary="@string/neocont_settings_appearance_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="eu.siacs.conversations.ui.SettingsActivity"
            android:targetPackage="@string/applicationId">
            <extra android:name="page" android:value="neocont_appearance" />
        </intent>

        <eu.siacs.conversations.ui.appearance.AppearancePreviewPreference
            android:key="neocont_appearance_preview"
            android:selectable="false" />
        <eu.siacs.conversations.ui.appearance.AppearanceChoicePreference
            android:key="theme"
            android:summary="@string/appearance_theme_description"
            android:title="@string/pref_theme_options" />
        <eu.siacs.conversations.ui.appearance.AppearanceChoicePreference
            android:key="appearance_color_source"
            android:summary="@string/appearance_color_source_description"
            android:title="@string/appearance_color_source" />
        <eu.siacs.conversations.ui.appearance.AppearanceChoicePreference
