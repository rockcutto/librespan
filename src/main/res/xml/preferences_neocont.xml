        android:layout="@layout/preference_navigation_row"
        android:title="@string/neocont_settings_chats"
        android:summary="@string/neocont_settings_chats_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="eu.siacs.conversations.ui.SettingsActivity"
            android:targetPackage="@string/applicationId">
            <extra android:name="page" android:value="neocont_chats" />
        </intent>

        <PreferenceCategory
            android:layout="@layout/preference_category_header"
            android:title="@string/neocont_chat_conversation">
            <SwitchPreference
                android:defaultValue="@bool/show_contact_status"
                android:key="show_contact_status"
                android:layout="@layout/preference_setting_row"
                android:summary="@string/neocont_show_contact_status_summary"
                android:title="@string/neocont_show_contact_status"
                android:widgetLayout="@layout/preference_app_switch" />
            <SwitchPreference
                android:defaultValue="@bool/message_hyphenation"
                android:key="message_hyphenation"
                android:layout="@layout/preference_setting_row"
                android:summary="@string/neocont_message_hyphenation_summary"
                android:title="@string/neocont_message_hyphenation"
                android:widgetLayout="@layout/preference_app_switch" />
            <SwitchPreference
                android:defaultValue="@bool/allow_message_correction"
                android:key="allow_message_correction"
                android:layout="@layout/preference_setting_row"
