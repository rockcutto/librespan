<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/call_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?colorSurface">

        <LinearLayout
            android:id="@+id/pip_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?colorSurfaceInverse"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pip_waiting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateOnly="true"
                android:indeterminateTint="?colorOnSurfaceInverse"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pip_warning"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_warning_24dp"
                android:visibility="gone"
                app:tint="?colorOnSurfaceInverse" />
        </LinearLayout>

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:visibility="visible"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:minHeight="52dp"
                android:background="@android:color/transparent"
                app:contentInsetEnd="8dp"
                app:contentInsetStart="8dp" />

            <TextView
                android:id="@+id/with"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textAppearance="?textAppearanceHeadlineSmall"
                android:textColor="?colorOnSurface"
                android:visibility="gone"
                tools:text="Juliet Capulet" />

            <TextView
                android:id="@+id/with_jid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="jcapulet@example.com" />


        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:id="@+id/main_call_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/button_row"
            android:layout_below="@id/app_bar_layout">

            <LinearLayout
                android:id="@+id/call_identity_stack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/incoming_call_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="?textAppearanceTitleMedium"
                    android:textColor="?colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Входящий звонок"
                    tools:visibility="visible" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/contact_photo"
                    android:layout_width="@dimen/call_avatar_size"
                    android:layout_height="@dimen/call_avatar_size"
                    android:layout_marginTop="20dp"
                    android:elevation="1dp"
                    app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle"
                    app:strokeColor="?colorOutlineVariant"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:id="@+id/incoming_call_identity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/incoming_call_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="?textAppearanceHeadlineSmall"
                        android:textColor="?colorOnSurface"
                        tools:text="Александр" />

                    <TextView
                        android:id="@+id/incoming_call_jid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="?colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="alex@example.com"
                        tools:visibility="visible" />

                </LinearLayout>

                <TextView
                    android:id="@+id/active_call_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAppearance="?textAppearanceBodyMedium"
                    android:textColor="?colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Соединение"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:textAppearance="?textAppearanceTitleMedium"
                    android:textColor="?colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="01:23" />

                <ImageView
                    android:id="@+id/verified"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/background_call_verified"
                    android:padding="4dp"
                    android:src="@drawable/ic_verified_user_24dp"
                    android:visibility="gone"
                    app:tint="?colorOnPrimaryContainer" />
            </LinearLayout>

        </RelativeLayout>


        <LinearLayout
            android:id="@+id/remote_video_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/app_bar_layout"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:background="@android:color/black"
            android:gravity="center"
            android:visibility="gone">

            <eu.siacs.conversations.ui.widget.SurfaceViewRenderer
                android:id="@+id/remote_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:soundEffectsEnabled="false" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_call_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="?colorSurfaceInverse"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/video_audio_only_button"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/switch_to_audio_call"
                    android:visibility="gone"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_call_24dp"
                    app:iconSize="24dp"
                    app:iconTint="?colorOnSurfaceInverse" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/video_chat_button"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/switch_to_chat"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_chat_24dp"
                    app:iconSize="24dp"
                    app:iconTint="?colorOnSurfaceInverse" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/local_video_container"
            android:layout_width="@dimen/local_video_preview_width"
            android:layout_height="@dimen/local_video_preview_height"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="68dp"
            android:layout_marginEnd="@dimen/call_local_video_margin_end"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/black"
            app:cardCornerRadius="@dimen/call_local_video_corner_radius"
            app:cardElevation="4dp"
            app:strokeColor="?colorOutlineVariant"
            app:strokeWidth="1dp">

            <eu.siacs.conversations.ui.widget.SurfaceViewRenderer
                android:id="@+id/local_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:soundEffectsEnabled="false"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pip_local_mic_off_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|bottom"
                android:layout_margin="8dp"
                android:background="@drawable/background_call_status_pill"
                android:padding="6dp"
                android:src="@drawable/ic_mic_off_24dp"
                android:visibility="gone"
                app:tint="?colorOnSurfaceInverse" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/reconnect_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/background_call_status_pill"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminate="true"
                android:indeterminateTint="?colorOnSurfaceInverse" />

            <TextView
                android:id="@+id/reconnect_overlay_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceInverse"
                tools:text="Reconnecting…" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/outgoing_video_upgrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/button_row"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="?colorSurfaceContainerHigh"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp">

                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/call_connecting_video"
                    android:textAppearance="?textAppearanceBodyLarge"
                    android:textColor="?colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/outgoing_video_upgrade_cancel"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/incoming_video_offer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/button_row"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="?colorSurfaceContainerHigh"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/incoming_video_offer_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?textAppearanceBodyLarge"
                    android:textColor="?colorOnSurface"
                    tools:text="Juliet offers to turn on video" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/incoming_video_offer_reject"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/not_now" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/incoming_video_offer_accept"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/accept_video" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <RelativeLayout
            android:id="@+id/button_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/call_controls_margin_horizontal"
            android:layout_marginEnd="@dimen/call_controls_margin_horizontal"
            android:layout_marginBottom="@dimen/call_controls_margin_bottom"
            android:background="@android:color/transparent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <RelativeLayout
                android:id="@+id/incoming_call_actions"
                android:layout_width="@dimen/call_incoming_actions_width"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@android:color/transparent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/reject_call_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/reject_call"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_margin="16dp"
                    android:src="@drawable/ic_call_end_24dp"
                    android:visibility="gone"
                    app:backgroundTint="?colorErrorContainer"
                    app:elevation="1dp"
                    app:fabCustomSize="@dimen/call_incoming_fab_size"
                    app:maxImageSize="@dimen/call_incoming_icon_size"
                    app:tint="?colorOnErrorContainer"
                    tools:visibility="visible" 
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/dismiss_call"
                        android:textAppearance="?textAppearanceLabelMedium"
                        android:textColor="?colorError" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/accept_call_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/accept_call"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="16dp"
                    android:src="@drawable/ic_call_24dp"
                    android:visibility="gone"
                    app:backgroundTint="?colorPrimaryContainer"
                    app:elevation="1dp"
                    app:fabCustomSize="@dimen/call_incoming_fab_size"
                    app:maxImageSize="@dimen/call_incoming_icon_size"
                    app:tint="?colorOnPrimaryContainer"
                    tools:visibility="visible" 
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/answer_call"
                        android:textAppearance="?textAppearanceLabelMedium"
                        android:textColor="?colorOnSurfaceVariant" />
                </LinearLayout>

            </RelativeLayout>

            <TextView
                android:id="@+id/using_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/incoming_call_actions"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/using_account"
                android:textAppearance="?textAppearanceLabelSmall"
                android:textColor="?colorOnSurfaceVariant"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/terminal_call_actions"
                android:layout_width="@dimen/call_incoming_actions_width"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@android:color/transparent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/terminal_exit"
                        style="?attr/floatingActionButtonSmallSurfaceStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:src="@drawable/ic_clear_24dp"
                        app:elevation="1dp"
                        app:fabCustomSize="@dimen/call_incoming_fab_size"
                        app:maxImageSize="@dimen/call_incoming_icon_size" 
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/close_call_screen"
                        android:textAppearance="?textAppearanceLabelMedium"
                        android:textColor="?colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/terminal_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:src="@drawable/ic_replay_24dp"
                        app:backgroundTint="?colorPrimaryContainer"
                        app:elevation="1dp"
                        app:fabCustomSize="@dimen/call_incoming_fab_size"
                        app:maxImageSize="@dimen/call_incoming_icon_size"
                        app:tint="?colorOnPrimaryContainer" 
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/try_again"
                        android:textAppearance="?textAppearanceLabelMedium"
                        android:textColor="?colorOnSurfaceVariant" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/in_call_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/background_call_controls_island"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/in_call_audio_route_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/in_call_audio_route"
                        style="?attr/floatingActionButtonSmallSurfaceStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" 
                        app:fabCustomSize="@dimen/call_control_fab_size"
                        app:maxImageSize="@dimen/call_control_icon_size"
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                    <TextView
                        android:id="@+id/in_call_audio_route_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/audio_output"
                        android:textAppearance="?textAppearanceLabelSmall"
                        android:textSize="@dimen/call_control_label_size"
                        android:textColor="?colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/in_call_action_left_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/in_call_action_left"
                        style="?attr/floatingActionButtonSmallSurfaceStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" 
                        app:fabCustomSize="@dimen/call_control_fab_size"
                        app:maxImageSize="@dimen/call_control_icon_size"
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                    <TextView
                        android:id="@+id/in_call_action_left_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/call_action_microphone"
                        android:textAppearance="?textAppearanceLabelSmall"
                        android:textSize="@dimen/call_control_label_size"
                        android:textColor="?colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/in_call_action_right_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/in_call_action_right"
                        style="?attr/floatingActionButtonSmallSurfaceStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" 
                        app:fabCustomSize="@dimen/call_control_fab_size"
                        app:maxImageSize="@dimen/call_control_icon_size"
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                    <TextView
                        android:id="@+id/in_call_action_right_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/call_action_video"
                        android:textAppearance="?textAppearanceLabelSmall"
                        android:textSize="@dimen/call_control_label_size"
                        android:textColor="?colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/in_call_action_far_right_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/in_call_action_far_right"
                        style="?attr/floatingActionButtonSmallSurfaceStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" 
                        app:fabCustomSize="@dimen/call_control_fab_size"
                        app:maxImageSize="@dimen/call_control_icon_size"
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                    <TextView
                        android:id="@+id/in_call_action_far_right_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/call_action_camera"
                        android:textAppearance="?textAppearanceLabelSmall"
                        android:textSize="@dimen/call_control_label_size"
                        android:textColor="?colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/end_call_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/in_call_controls"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/end_call"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_call_end_24dp"
                    android:visibility="visible"
                    app:backgroundTint="?colorErrorContainer"
                    app:elevation="1dp"
                    app:fabCustomSize="@dimen/call_end_fab_size"
                    app:maxImageSize="@dimen/call_end_icon_size"
                    app:tint="?colorOnErrorContainer" 
                        app:shapeAppearance="@style/ShapeAppearanceOverlay.NeoCont.CallCircle" />

                <TextView
                    android:id="@+id/end_call_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/hang_up"
                    android:textAppearance="?textAppearanceLabelSmall"
                    android:textColor="?colorError" />
            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>
</layout>