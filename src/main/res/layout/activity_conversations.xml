<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/main_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottom_navigation" />

        <View
            android:id="@+id/status_bar_protection"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentTop="true"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/toolbar_matte_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@android:color/transparent"
            android:paddingTop="6dp"
            android:paddingBottom="0dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/conversation_header_island"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:transitionName="contact_container_transition"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/chat_chrome_island"
                app:cardCornerRadius="@dimen/app_island_corner_radius"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <include
                    android:id="@+id/toolbar_layout"
                    layout="@layout/toolbar_conversations" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>


        <View
            android:id="@+id/overview_header_protection"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_below="@id/toolbar_matte_zone"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_bar_height"
            android:layout_alignParentBottom="true"
            android:minHeight="0dp"
            app:itemPaddingTop="4dp"
            app:itemPaddingBottom="0dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_navigation_menu_chat"
            android:state_checked="true"
            android:visibility="gone" />
    </RelativeLayout>
</layout>
