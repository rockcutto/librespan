<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:addStatesFromChildren="true"
    android:background="@drawable/bg_toolbar_search_material"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="2dp">

    <EditText
        android:id="@+id/search_field"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:imeOptions="flagNoExtractUi|actionSearch"
        android:inputType="text|textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:selectAllOnFocus="false"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textCursorDrawable="@drawable/cursor_on_surface_container" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search_messages_action_inline"
        style="?attr/materialIconButtonStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/search_messages"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:backgroundTint="?attr/colorSurfaceContainerHighest"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_search_24dp"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:strokeWidth="0dp" />
</LinearLayout>
