<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="?dialogPreferredPadding">

        <TextView
            android:textAppearance="?attr/textAppearanceCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/your_account"/>

        <Spinner
            android:id="@+id/account"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.App.Dialog.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/create_dialog_group_chat_name">

            <eu.siacs.conversations.ui.widget.TextInputEditText
                android:id="@+id/group_chat_name"
                style="@style/Widget.App.Dialog.TextInputField"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</layout>
