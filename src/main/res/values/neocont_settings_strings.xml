    <string name="neocont_security_info">Security and encryption</string>
    <string name="neocont_security_info_summary">How the app protects messages and local data</string>
    <string name="neocont_security_e2ee_title">End-to-end encryption</string>
    <string name="neocont_security_e2ee_body">Protected chats use OMEMO. End-to-end encryption protects message contents between participants\' devices. The server is used for delivery, but with end-to-end encryption enabled it should not receive message contents in plaintext. Actual use depends on chat settings and support on participants\' devices.</string>
    <string name="neocont_security_local_title">Protection on this device</string>
    <string name="neocont_security_local_body">The app uses protected local storage for messages and media. New protected data is stored encrypted on the device. This is a separate protection layer that complements end-to-end encryption. Some historical data may remain in the legacy format until migration is complete.</string>
    <string name="neocont_security_access_title">Access to the app</string>
    <string name="neocont_security_access_body">The app can be protected using biometrics or the device\'s system unlock. This is the primary way to confirm access to the app and protected local data. Android may use the device PIN, password or pattern depending on system settings.</string>
    <string name="neocont_security_high_title">High Security</string>
    <string name="neocont_security_high_body">High Security strengthens protection of local keys and data. After prolonged inactivity, the app can lock protected data and disconnect accounts until the next successful authentication. A recovery phrase is used only as an emergency recovery mechanism for High Security, not as the normal way to unlock the app.</string>
    <string name="neocont_security_server_title">Server</string>
    <string name="neocont_security_server_body">The app does not require its own messaging server. You choose a messaging server yourself or use your own. Storage and metadata policies depend on the selected server. The app uses the open XMPP protocol.</string>
    <string name="neocont_security_limits_title">What encryption does not hide</string>
    <string name="neocont_security_limits_body">End-to-end encryption protects message contents, but it does not provide complete anonymity. Some service information needed for connecting and delivering messages may be visible to the server or network infrastructure.</string>
