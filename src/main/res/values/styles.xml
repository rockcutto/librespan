    <!--
        LibreSpan card system.
        Theme.Conversations3 installs Widget.App.Card as the MaterialCardView default so card
        chrome is controlled centrally instead of repeating stroke/elevation fixes per screen.
        Local styles should describe semantic surface/shape differences; outlined cards must opt in.
    -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/app_island_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.Card.SurfaceLow" parent="Widget.App.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="Widget.App.Card.Surface" parent="Widget.App.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Widget.App.Card.Panel" parent="Widget.App.Card.SurfaceLow">
        <item name="cardCornerRadius">@dimen/app_island_corner_radius</item>
    </style>

    <style name="Widget.App.Card.Action" parent="Widget.App.Card.Surface">
        <item name="cardCornerRadius">@dimen/app_island_corner_radius</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Widget.App.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="NeoCont.AttachmentPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_attachment_popup</item>
    </style>
